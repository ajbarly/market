---
interface Props {
    code: number;
    title: string;
    text: string;
}
const { code = '', title = '', text = '' } = Astro.props;
---

<div class="bg-gray-100 px-2 text-center">
    <div class="h-screen flex flex-col justify-center items-center">
        <h1 class="text-8xl font-extrabold text-red-500">{code}</h1>
        <p class="text-4xl font-medium text-gray-800">{title}</p>
        <p class="text-xl text-gray-800 mt-4">{text}</p>
    </div>
</div>
