---
import siteConfig from '../data/site-config.ts';

const { class: className } = Astro.props;
---

<header class:list={['px-4 py-4 flex gap-6 items-center justify-center sm:px-8 sm:py-6', className]}>
    <a href="/">
        <img class="max-h-12" src={siteConfig.logo?.src || '/ajbarly_logo.png'} alt={siteConfig.logo?.alt || 'Logo'} />
    </a>
</header>
