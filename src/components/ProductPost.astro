---
import type { Product } from '../data/models';
import AvailableIcon from '../icons/AvailableIcon.astro';
import UnavailableIcon from '../icons/UnavailableIcon.astro';

interface Props {
    product: Product;
}
const { product } = Astro.props;

// Format price information
let productPrice = '',
    beforeDiscount = '';

const suffix = ' MRU';
if (product.discount > 1) {
    productPrice = product.discount + suffix;
    beforeDiscount = (product.price ?? 0) + suffix;
} else {
    if (product.price === null) {
        productPrice = 'سعر غير متوفر';
    } else {
        productPrice = product.price + suffix;
    }
}

// Parse and format warranty information if available
let warrantyText = '';
if (product.warranty) {
    try {
        // Parse the warranty string if it's in JSON format
        let warrantyData;
        if (typeof product.warranty === 'string') {
            warrantyData = JSON.parse(product.warranty);
        } else {
            warrantyData = product.warranty;
        }

        // Extract warranty information
        const unitDisplay = warrantyData.unit === 'year' ? 'سنة' : warrantyData.unit === 'month' ? 'شهر' : 'يوم';

        warrantyText = `${warrantyData.duration} ${unitDisplay}`;
    } catch (e) {
        console.error('Error parsing warranty data:', e);
    }
}

// Define stock status types
type StockStatus = 'inStock' | 'outOfStock' | 'limitedAvailability';

// Format stock status
const stockStatusMap = {
    inStock: { label: 'متوفر', color: 'green' },
    outOfStock: { label: 'نفذت الكمية', color: 'red' },
    limitedAvailability: { label: 'كمية محدودة', color: 'yellow' }
};

// Ensure product.stock is a valid key, otherwise use default
const stockStatus = product.stock && product.stock in stockStatusMap ? stockStatusMap[product.stock as StockStatus] : { label: 'غير معروف', color: 'gray' };

// Generate deep link
const redirectUrl = 'intent://ajbarly.app/market/product/' + product.id + '/#Intent;scheme=https;package=app.ajbarly;end';

// Calculate safe satisfaction percentage
const satisfactionPercentage =
    product.satisfied && product.satisfied + product.unsatisfied > 0 ? Math.round((product.satisfied / (product.satisfied + product.unsatisfied)) * 100) : 0;

// Calculate safe discount percentage
const discountPercentage = product.price && product.discount ? Math.round(((product.price - product.discount) / product.price) * 100) : 0;
---

<div class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-8">
        <div class="flex flex-wrap -mx-4">
            <!-- Product Image - Single Image Only -->
            <div class="w-full md:w-1/2 px-4 mb-8">
                <div class="sticky top-4">
                    <div class="relative overflow-hidden rounded-lg shadow-lg bg-white p-2">
                        <img src={product.images[0]} alt={product.name} class="w-full h-auto rounded-lg object-cover aspect-square" />

                        {
                            product.stock === 'outOfStock' && (
                                <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
                                    <span class="text-white text-xl font-bold px-4 py-2 bg-red-600 rounded-lg rotate-12">نفذت الكمية</span>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- Product Details -->
            <div class="w-full md:w-1/2 px-4">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <!-- Store Info -->
                    <div class="flex items-center mb-4">
                        <img src={product.storeLogo} alt={product.storeName} class="w-10 h-10 rounded-full object-cover mr-3" />
                        <h3 class="text-gray-700">{product.storeName}</h3>
                    </div>

                    <!-- Product Title & Status -->
                    <div class="flex flex-wrap justify-between items-start mb-4">
                        <h2 class="text-3xl font-bold mb-2 flex-1">{product.name}</h2>

                        {
                            product.state && (
                                <div
                                    class={`inline-flex items-center rounded px-4 py-2 font-semibold text-white
                                    ${
                                        product.state === 'new'
                                            ? 'bg-green-500 [box-shadow:rgb(34,_197,94,.2)-8px_8px]'
                                            : 'bg-red-500 [box-shadow:rgb(220,38,38,.2)-8px_8px]'
                                    }`}
                                >
                                    {product.state === 'new' ? 'جديد' : 'مستعمل'}
                                </div>
                            )
                        }
                    </div>

                    <!-- Stock Status -->
                    {
                        product.stock && stockStatus && (
                            <div
                                class={`mb-4 inline-block px-3 py-1 rounded-full text-sm font-medium bg-${stockStatus.color}-100 text-${stockStatus.color}-800 border border-${stockStatus.color}-200`}
                            >
                                <span class="flex items-center">
                                    <span class={`w-2 h-2 rounded-full bg-${stockStatus.color}-500 mr-2`} />
                                    {stockStatus.label}
                                </span>
                            </div>
                        )
                    }

                    <!-- Price Info -->
                    <div class="flex flex-wrap items-baseline mb-6" dir="ltr">
                        {beforeDiscount && <span class="text-gray-500 line-through decoration-red-500 mr-2 text-lg">{beforeDiscount}</span>}
                        <span class="text-3xl font-bold text-gray-900">{productPrice}</span>

                        {
                            beforeDiscount && product.price !== null && product.discount && (
                                <span class="ml-2 bg-red-100 text-red-800 text-xs font-medium px-2 py-0.5 rounded">{discountPercentage}% خصم</span>
                            )
                        }
                    </div>

                    <!-- Product Features -->
                    <div class="mb-6 bg-gray-50 rounded-lg p-4">
                        <h3 class="text-lg font-semibold mb-3 text-gray-800">مزايا العرض</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="flex items-center">
                                <span class={`mr-2 ${product.deliverable ? 'text-green-500' : 'text-red-500'}`}>
                                    {product.deliverable ? <AvailableIcon /> : <UnavailableIcon />}
                                </span>
                                <span>قابل للتوصيل</span>
                            </div>

                            <div class="flex items-center">
                                <span class={`mr-2 ${product.negotiable ? 'text-green-500' : 'text-red-500'}`}>
                                    {product.negotiable ? <AvailableIcon /> : <UnavailableIcon />}
                                </span>
                                <span>قابل للتفاوض</span>
                            </div>

                            {
                                product.refund !== null && (
                                    <div class="flex items-center">
                                        <span class={`mr-2 ${product.refund ? 'text-green-500' : 'text-red-500'}`}>
                                            {product.refund ? <AvailableIcon /> : <UnavailableIcon />}
                                        </span>
                                        <span>قابل للإرجاع</span>
                                    </div>
                                )
                            }

                            {
                                warrantyText && (
                                    <div class="flex items-center">
                                        <span class={`mr-2 ${product.refund ? 'text-green-500' : 'text-red-500'}`}>
                                            {product.refund ? <AvailableIcon /> : <UnavailableIcon />}
                                        </span>
                                        <span>ضمان: {warrantyText}</span>
                                    </div>
                                )
                            }
                        </div>
                    </div>

                    <!-- Product Details -->
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold mb-3 text-gray-800">وصف</h3>
                        <p class="text-gray-700 whitespace-pre-wrap bg-gray-50 rounded-lg p-4 max-h-56 overflow-y-auto">
                            {product.details}
                        </p>
                    </div>

                    <!-- User Engagement -->
                    <div class="mb-6 flex flex-wrap justify-between items-center bg-gray-50 rounded-lg p-4">
                        <div class="flex items-center space-x-4 rtl:space-x-reverse">
                            <div class="flex flex-col items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" height="24" width="24">
                                    <path
                                        fill="#74c0fc"
                                        d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z"
                                    ></path>
                                </svg>
                                <span class="text-sm text-gray-500 mt-1">{product.views} مشاهدة</span>
                            </div>

                            <div class="flex space-x-6 rtl:space-x-reverse">
                                <div class="flex flex-col items-center">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-green-500"
                                    >
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                                        <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                        <line x1="15" y1="9" x2="15.01" y2="9"></line>
                                    </svg>
                                    <span class="text-sm text-gray-500 mt-1">{product.satisfied}</span>
                                </div>

                                <div class="flex flex-col items-center">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-red-500"
                                    >
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="8" y1="15" x2="16" y2="15"></line>
                                        <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                        <line x1="15" y1="9" x2="15.01" y2="9"></line>
                                    </svg>
                                    <span class="text-sm text-gray-500 mt-1">{product.unsatisfied}</span>
                                </div>
                            </div>
                        </div>

                        {
                            product.satisfied + product.unsatisfied > 0 && (
                                <div class="mt-2 sm:mt-0">
                                    <div class="flex items-center">
                                        <div class="w-40 bg-gray-200 rounded-full h-2.5">
                                            <div class="bg-green-600 h-2.5 rounded-full" style={`width: ${satisfactionPercentage}%`} />
                                        </div>
                                        <span class="text-sm text-gray-500 ml-2">{satisfactionPercentage}% راضون</span>
                                    </div>
                                </div>
                            )
                        }
                    </div>

                    <!-- Call to Action Button -->
                    <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4 sm:rtl:space-x-reverse">
                        <a
                            href={product.orderable ? '#order' : redirectUrl}
                            class={`w-full group relative cursor-pointer overflow-hidden whitespace-nowrap px-6 py-4 text-white 
                                [background:var(--bg)] [border-radius:var(--radius)] transition-all duration-300 hover:scale-105 
                                hover:shadow-[0_0_40px_8px_rgba(62,61,117,0.7)] flex justify-center items-center space-x-2
                                ${product.stock === 'outOfStock' ? 'opacity-50 pointer-events-none' : ''}`}
                            style="--spread: 90deg; --shimmer-color: #ffffff; --radius: 100px; --speed: 1.5s; --cut: 0.1em; --bg: radial-gradient(circle at 50% 50%, #ff7e5f, #feb47b);"
                            aria-disabled={product.stock === 'outOfStock'}
                        >
                            <div class="absolute inset-0 overflow-hidden">
                                <div class="absolute inset-[-100%] rotate-gradient">
                                    <div
                                        class="absolute inset-0 [background:conic-gradient(from_calc(270deg-(var(--spread)*0.5)),transparent_0,hsl(0_0%_100%/1)_var(--spread),transparent_var(--spread))]"
                                    >
                                    </div>
                                </div>
                            </div>
                            <div class="absolute [background:var(--bg)] [border-radius:var(--radius)] [inset:var(--cut)]"></div>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" height="24" width="24" class="z-10 animate-bounce">
                                <path
                                    fill="#FFD43B"
                                    d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"
                                ></path>
                            </svg>

                            <span
                                class="z-10 whitespace-pre bg-gradient-to-b from-black from-30% to-gray-300/80 bg-clip-text text-center text-lg font-semibold leading-none tracking-tight text-white animate-pulse"
                            >
                                {product.stock === 'outOfStock' ? 'نفذت الكمية' : 'تسوق الآن'}
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" height="24" width="24" class="z-10 animate-bounce">
                                <path
                                    fill="#FFD43B"
                                    d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
    .rotate-gradient {
        animation: spin 4s linear infinite;
        animation-timing-function: linear; /* Ensure constant speed */
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .container {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }
</style>
