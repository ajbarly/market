---
// src/pages/market/rental/p/[id].astro
import NoHeaderLayout from '../../../layouts/NoHeaderLayout.astro';
import Header from '../../../components/Header.astro';
import Hero from '../../../components/Hero.astro';
import siteConfig from '../../../data/site-config';
import Subscribe from '../../../components/Market.astro';
import { appwriteException, getRentalPost, getRentalImageUrl, getName } from '../../../data/services';
import ErrorMessage from '../../../components/ErrorMessage.astro';
import { CustomError } from '../../../utils/custom_error';
import { isBot, getAppStoreUrl } from '../../../utils/bot-detection';

const { id } = Astro.params || '';

if (id === '') {
    return Astro.redirect('/');
}

// ─── Bot detection ────────────────────────────────────────────────────────────
const userAgent = Astro.request.headers.get('user-agent') ?? '';
if (!isBot(userAgent)) {
    return Astro.redirect(getAppStoreUrl(userAgent), 302);
}
// ─────────────────────────────────────────────────────────────────────────────

// Deep link that opens the for-rent post inside the app
const appDeepLink = `intent://ajbarly.app/market/rental/p/${id}/#Intent;scheme=https;package=app.ajbarly;end`;

let metaTitle = 'عرض إيجار';
let metaDescription = siteConfig.description;
let metaImage: { src: string; alt?: string } | undefined = siteConfig.image;

let postTitle = '';
let postDescription = '';
let postPrice = '';
let postImage = '';
let postLocation = '';

let hasError = false;
let errorInstance: CustomError = new CustomError(0, '', '');

try {
    const result = await getRentalPost(id!);

    // ── Adapt these field names to match your actual Appwrite table columns ──
    postTitle = result.title ?? '';
    postDescription = result.description ?? '';
    postPrice = result.price ? `${result.price} MRU` : 'سعر غير متوفر';
    postLocation = result.location ?? '';
    postImage = result.image ? getRentalImageUrl(result.image) : (siteConfig.image?.src ?? '');
    // ─────────────────────────────────────────────────────────────────────────

    metaTitle = postTitle || 'عرض إيجار';
    metaDescription = postDescription || siteConfig.description;
    metaImage = { src: postImage, alt: postTitle };
} catch (error: any) {
    hasError = true;
    if (error instanceof appwriteException) {
        errorInstance =
            error.code === 404
                ? new CustomError(404, 'العرض غير متاح', 'لم يتم العثور على هذا العرض أو تم حذفه.')
                : new CustomError(505, siteConfig.error?.title!, siteConfig.error?.text!);
    }
}
---

<NoHeaderLayout title={metaTitle} description={metaDescription} image={metaImage}>
    <div class="relative bg-slate-50 border-b border-slate-100">
        <div class="relative isolate overflow-hidden bg-slate-100">
            <Header class="relative" />

            <main class="py-10 px-4 sm:px-8">
                {
                    hasError ? (
                        <ErrorMessage code={errorInstance.code} title={errorInstance.title} text={errorInstance.text} />
                    ) : (
                        <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
                            {postImage && <img src={postImage} alt={postTitle} class="w-full h-64 object-cover" onerror="this.src='/broken_product.jpg'" />}

                            <div class="p-6">
                                <span class="inline-block bg-primary text-white text-xs font-semibold px-3 py-1 rounded-full mb-3">للإيجار</span>

                                <h1 class="text-2xl font-bold text-gray-800 mb-2">{postTitle}</h1>

                                {postLocation && <p class="text-sm text-gray-500 mb-3 flex items-center gap-1">📍 {postLocation}</p>}

                                <p class="text-3xl font-bold text-primary mb-4">{postPrice}</p>

                                <p class="text-gray-600 whitespace-pre-wrap">{postDescription}</p>

                                <a
                                    href={appDeepLink}
                                    class="mt-6 block w-full text-center bg-primary text-white font-semibold py-3 rounded-full transition hover:opacity-90"
                                >
                                    فتح في التطبيق
                                </a>
                            </div>
                        </div>
                    )
                }
            </main>

            <Hero />
        </div>

        <section class="grow py-12 sm:py-16">
            <Subscribe class="px-4 my-12 sm:px-8 sm:my-16" />
        </section>
    </div>
</NoHeaderLayout>
