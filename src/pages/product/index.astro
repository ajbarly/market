---
import NoHeaderLayout from '../../layouts/NoHeaderLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import siteConfig from '../../data/site-config';
import Subscribe from '../../components/Market.astro';
import { appwriteException, getDocument, getProductImageUrl } from '../../data/services';
import ErrorMessage from '../../components/ErrorMessage.astro';
import { CustomError } from '../../utils/custom_error';

const id = Astro.url.searchParams.get('id') || '';

if (id === '') {
    return Astro.redirect('/');
}

let metaTitle = siteConfig.product?.title;
let productName = '';
let productPrice = '',
    beforeDiscount = '';
let productDetails = siteConfig.product?.text;
const redirectUrl =
    'intent://product?id=' +
    id +
    '#Intent;scheme=http;host=market.ajbarly.app;package=app.ajbarly;S.browser_fallback_url=https://play.google.com/store/apps/details?id=app.ajbarly;end';
let hasError: boolean = false;
let errorInstance: CustomError = new CustomError(0, '', '');
try {
    const result = await getDocument(false, id);
    productName = result.product_name;
    productDetails = result.product_details;
    var productPreview = result.product_imgs || '';
    const price = result.product_price;
    const discount = result.product_dicount_price;

    metaTitle = productName;
    if (productPreview !== '') {
        productPreview = getProductImageUrl(productPreview[0]);
    } else {
        productPreview = siteConfig.market?.coverUrl;
    }

    const suffix = ' MRU';
    if (discount > 1) {
        productPrice = discount + suffix;
        beforeDiscount = price + suffix;
    } else {
        productPrice = price + suffix;
    }
} catch (error: any) {
    hasError = true;
    if (error instanceof appwriteException) {
        if (error.code !== 404) {
            errorInstance = new CustomError(505, siteConfig.error?.title!, siteConfig.error?.text!);
        }
        errorInstance = new CustomError(404, metaTitle!, productDetails!);
        productPreview = siteConfig.product?.cover;
    }
}
---

<NoHeaderLayout title={metaTitle} description={productDetails} image={siteConfig.image}>
    <div class="relative bg-slate-50 border-b border-slate-100">
        <div class="relative isolate overflow-hidden bg-slate-100">
            <Header class="relative" />
            <Hero>
                {
                    hasError ? (
                        <ErrorMessage code={errorInstance.code} title={errorInstance.title} text={errorInstance.text} />
                    ) : (
                        <section class="mt-7 px-3 py-5 lg:py-10">
                            <div class="grid lg:grid-cols-2 items-center justify-items-center gap-5">
                                <div class="order-2 lg:order-1 flex flex-col justify-center items-center">
                                    <div dir="ltr">
                                        <div class="mt-4">
                                            <span class="text-red-500 text-2xl line-through">{beforeDiscount}</span>
                                        </div>
                                        <div class="mt-1">
                                            <span class="text-4xl font-bold md:text-7xl text-orange-600">{productPrice}</span>
                                        </div>
                                    </div>
                                    <p class="text-4xl font-bold md:text-7xl">{productName}</p>
                                    <p class="mt-2 line-clamp-5 text-sm md:text-lg">{productDetails}</p>
                                    <a href={redirectUrl} class="z-10 text-lg md:text-2xl bg-primary text-white py-2 px-5 mt-10">
                                        مزيد من التفاصيل
                                    </a>
                                </div>
                                <div class="order-1 lg:order-2">
                                    <img
                                        class="h-80 w-80 object-cover lg:w-[500px] lg:h-[500px]"
                                        src={productPreview}
                                        alt={productName}
                                        onerror="this.src='/broken_avatar.png'"
                                    />
                                </div>
                            </div>
                        </section>
                    )
                }</Hero
            >
        </div>
        <main class="grow py-12 sm:py-16">
            <Subscribe class="px-4 my-12 sm:px-8 sm:my-16" />
        </main>
    </div>
</NoHeaderLayout>
