// src/pages/market/store/[id].astro
import NoHeaderLayout from '../../../layouts/NoHeaderLayout.astro';
import Header from '../../../components/Header.astro';
import Hero from '../../../components/Hero.astro';
import siteConfig, { type Store } from '../../../data/site-config';
import Subscribe from '../../../components/Market.astro';
import { appwriteException, getRow, getStoreImageUrl } from '../../../data/services';
import { isOpen } from '../../../utils/store_available';
import { getCategoryName } from '../../../utils/store_category';
import ErrorMessage from '../../../components/ErrorMessage.astro';
import { CustomError } from '../../../utils/custom_error';
import { isBot, getAppStoreUrl } from '../../../utils/bot-detection';
import type { Models } from 'node-appwrite';

const { id } = Astro.params || '';

if (id === '') {
    return Astro.redirect('/');
}

let metaTitle = siteConfig.store?.title;
let store: Store;
let about = siteConfig.store?.text;
let cover = siteConfig.store?.cover;
// const redirectUrl = 'intent://ajbarly.app/market/store/' + id + '/#Intent;scheme=https;package=app.ajbarly;end';
let hasError: boolean = false;
let errorInstance: CustomError = new CustomError(0, '', '');

try {
    const result = await getRow(true, id!);
    store = setStore(result);

    about = store.details;
    cover = { src: store.cover, alt: store.name };
    metaTitle = store.name;

    if (cover.src === '') {
        cover.src = siteConfig.market?.coverUrl!;
    }
} catch (error: any) {
    hasError = true;
    if (error instanceof appwriteException) {
        if (error.code !== 404) {
            errorInstance = new CustomError(505, siteConfig.error?.title!, siteConfig.error?.text!);
        }
        errorInstance = new CustomError(404, metaTitle!, about!);
        cover = siteConfig.store?.cover;
    }
}

// ─── Bot detection ────────────────────────────────────────────────────────────
// Link-preview crawlers (WhatsApp, Telegram, Facebook …) are allowed through
// so they can read the OG meta tags and render a rich preview card.
// Real users who click the link (and don't have the app) are sent straight
// to the appropriate app store.
const userAgent = Astro.request.headers.get('user-agent') ?? '';
if (!isBot(userAgent)) {
    return Astro.redirect(getAppStoreUrl(userAgent), 302);
}
// ─────────────────────────────────────────────────────────────────────────────
