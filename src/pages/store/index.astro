---
import NoHeaderLayout from '../../layouts/NoHeaderLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import siteConfig from '../../data/site-config';
import Subscribe from '../../components/Market.astro';
import { appwriteException, getDocument, getName, getStoreImageUrl } from '../../data/services';
import { isOpen } from '../../utils/store_available';
import { getCategoryName } from '../../utils/store_category';
import ErrorMessage from '../../components/ErrorMessage.astro';
import { CustomError } from '../../utils/custom_error';

const id = Astro.url.searchParams.get('id') || '';

if (id === '') {
    return Astro.redirect('/');
}

let metaTitle = siteConfig.store?.title;
let storeName = '',
    categoryName = '';
let aboutStore = siteConfig.store?.text;
let storeAvatar = '';
let counter = '';
let availability = '';
const redirectUrl =
    'intent://store?id=' +
    id +
    '#Intent;scheme=http;host=market.ajbarly.app;package=app.ajbarly;S.browser_fallback_url=https://play.google.com/store/apps/details?id=app.ajbarly;end';
let hasError: boolean = false;
let errorInstance: CustomError = new CustomError(0, '', '');
try {
    const result = await getDocument(true, id);

    storeName = getName(`${result.store_name}`);
    categoryName = getCategoryName(result.store_type);
    aboutStore = result.store_about;
    storeAvatar = getStoreImageUrl(result.store_avatar);
    availability = isOpen(result.store_opens, result.store_closes);
    var storeCover = result.store_cover || '';

    metaTitle = storeName;
    counter = result.store_product_counter;
    if (storeCover !== '') {
        storeCover = getStoreImageUrl(storeCover);
    } else {
        storeCover = siteConfig.market?.coverUrl;
    }
} catch (error: any) {
    hasError = true;
    if (error instanceof appwriteException) {
        if (error.code !== 404) {
            errorInstance = new CustomError(505, siteConfig.error?.title!, siteConfig.error?.text!);
        }
        errorInstance = new CustomError(404, metaTitle!, aboutStore!);
        storeCover = siteConfig.store?.cover;
        counter = error.message + ' ' + error.code;
    }
}
---

<NoHeaderLayout title={metaTitle} description={aboutStore} image={storeCover}>
    <div class="relative bg-slate-50 border-b border-slate-100">
        <div class="relative isolate overflow-hidden bg-slate-100">
            <Header class="relative" />
            <Hero>
                {
                    hasError ? (
                        <ErrorMessage code={errorInstance.code} title={errorInstance.title} text={errorInstance.text} />
                    ) : (
                        <div class="mt-7 flex flex-wrap items-center justify-center">
                            <div class="container lg:w-2/6 xl:w-2/7 sm:w-full md:w-2/3 bg-white transform duration-200 easy-in-out">
                                <div class="h-52 overflow-hidden">
                                    <img class="w-full" src={storeCover} alt="Store cover" onerror="this.src='/broken_store.jpg'" />
                                </div>
                                <div class="flex justify-center px-5 -mt-12">
                                    <img
                                        class="h-32 w-32 bg-white p-2 rounded-full"
                                        src={storeAvatar}
                                        alt="Store avatar"
                                        onerror="this.src='/broken_avatar.png'"
                                    />
                                </div>
                                <div class="">
                                    <div class="text-center px-14">
                                        <h2 class="text-gray-800 text-3xl font-bold">{storeName}</h2>
                                        <span class="text-gray-400 mt-2">{categoryName}</span>
                                        <p class="mt-2 text-gray-500 text-sm">{aboutStore}</p>
                                    </div>
                                    <hr class="mt-6" />
                                    <div class="flex bg-gray-50">
                                        <div class="text-center w-1/2 p-4">
                                            <p>
                                                <span class="font-semibold">{counter} </span> منتج
                                            </p>
                                        </div>
                                        <div class="border" />
                                        <div class="text-center w-1/2 p-4">
                                            <p>
                                                <span class="font-semibold" /> {availability}
                                            </p>
                                        </div>
                                        <div class="border" />
                                        <div class="text-center w-1/2 p-4 bg-primary text-white">
                                            <a href={redirectUrl} class="inline-flex items-center">
                                                <span> زيارة </span>
                                                <svg
                                                    class="w-5 mr-4 rotate-180"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )
                }
            </Hero>
        </div>
        <main class="grow py-12 sm:py-16">
            <Subscribe class="px-4 my-12 sm:px-8 sm:my-16" />
        </main>
    </div>
</NoHeaderLayout>
